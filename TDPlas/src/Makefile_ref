# mpi flags (not used here)
MPI= -DMPI

LDLAGS=
#LDLAGS= --static --disable-shared --enable-static

# actual flags used in the compilation
#FFLAGS= $(FFLAGS_GF) ${OMP} #-heap-arrays 1024
