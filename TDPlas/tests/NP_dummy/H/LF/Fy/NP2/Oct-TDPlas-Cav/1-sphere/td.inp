CalculationMode = td
UnitsOutput = eV_Angstrom

XYZCoordinates = 'H.xyz'

TDPropagator = aetrs
TDTimeStep = 0.0023/eV
TDMaxSteps = 50

radius = 10.0*angstrom
spacing = 0.23*angstrom

PCMCalculation = yes
PCMTDPlasBinding = yes
PCMLocalField = yes

amplitude = 1*eV/angstrom
omega = 18.0*eV
tau0 = 0.5/eV
t0 = tau0

%TDExternalFields
  electric_field | 0 | 1 | 0 | omega | "envelope_cos"
%
 
%TDFunctions
  "envelope_cos" | tdf_cosinoidal | amplitude | tau0 | t0
%

FromScratch = yes
ExperimentalFeatures = yes
