&SYSTEM
out_level='high'
/

&OUT_MATRIX
gamess='gamess'
print_lf_matrix = 'print'
/

&DO_EPS
/

&MEDIUM
medium_type='sol'
medium_pol='charge'
bem_type='diagonal'
bem_read_write='write'
local_field='local'
/

&SURFACE
surface_type='mesh'
input_mesh='built'
spheres_number=1
sphere_position_x=0.
sphere_position_y=0.
sphere_position_z=0.
sphere_radius=10
/

&EPS_FUNCTION
epsilon_omega='debye'
eps_0=35.84
eps_d=1.806
tau_deb=1.393204E+5
/

&PRINT_CHARGES
/

&QUANTUM_COUPLING
/

