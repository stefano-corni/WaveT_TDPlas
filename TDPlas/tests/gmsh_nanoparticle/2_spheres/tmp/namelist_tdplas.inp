&SYSTEM
/
&OUT_MATRIX
/
&MEDIUM
medium_type='nanop'
medium_pol='charge'
bem_type='diagonal'
bem_read_write='write'
/

&SURFACE
surface_type = 'mesh'
input_mesh = 'gms'
/

&EPS_FUNCTION
epsilon_omega='drude-lorentz'
eps_A=0.110224   
eps_gm=0.00757576
eps_w0=0.  
f_vel=0. 
/

&print_charges
/
&QUANTUM_COUPLING
/
