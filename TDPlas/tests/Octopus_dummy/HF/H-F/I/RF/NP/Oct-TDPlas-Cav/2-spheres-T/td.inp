CalculationMode = td
UnitsOutput = eV_Angstrom

XYZCoordinates = 'HF.xyz'

PseudopotentialSet = hgh_lda

TDPropagator = aetrs
TDTimeStep = 0.0023/eV
TDMaxSteps = 50

TDDeltaStrength = 0.01/angstrom
TDPolarizationDirection = 3

radius = 10.0*angstrom
spacing = 0.23*angstrom

PCMCalculation = yes
PCMTDPlasBinding = yes

FromScratch = yes
ExperimentalFeatures = yes
