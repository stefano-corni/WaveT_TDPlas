&SYSTEM
/
&OUT_MATRIX
/
&MEDIUM
medium_type='sol'
medium_pol='charge'
bem_type='diagonal'
bem_read_write='write'
/
&SURFACE
create_cavity = 'built'
input_surface = 'cavity'
spheres_number=1
sphere_position_x=0.
sphere_position_y=0.
sphere_position_z=0.
sphere_radius=10
/

&EPS_FUNCTION
epsilon_omega='debye'
eps_0=35.84
eps_d=1.806
tau_deb=1.393204E+5
/
&print_charges
/

