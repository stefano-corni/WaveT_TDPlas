&SYSTEM
test_type='n-r'
/
&OUT_MATRIX
/
&MEDIUM
medium_type='nano+sol'
medium_init0='frozen'
bem_type='standard'
bem_read_write='read'
local_field='non'
/
&SURFACE
surface_type='mesh'
input_mesh = 'read_file'
dummy_surface = 'yes'
dum_spheres_number=1
dum_sphere_position_x= 11.338355932
dum_sphere_position_y=  0.
dum_sphere_position_z=  0.
dum_sphere_radius= 4.7243149714
/

&EPS_FUNCTION
epsilon_omega='general'
propagation_pole="first-order"
eps_0_dum=1.01
eps_d_dum=1.01
/
&PROPAGATE  
propagation_type='charge-ief'
interaction_type='pcm'
interaction_stride=1
interaction_init='nsc'
/
&QUANTUM_COUPLING
/

