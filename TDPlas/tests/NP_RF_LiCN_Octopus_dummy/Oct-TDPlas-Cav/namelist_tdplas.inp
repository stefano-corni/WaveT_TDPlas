&SYSTEM
test_type='n-r'
/
&OUT_MATRIX
/
&MEDIUM
medium_type='nanop'
medium_init0='frozen'
bem_type='diagonal'
bem_read_write='read'
local_field='non'
/
&SURFACE
surface_type='mesh'
input_mesh = 'read_file'
dummy_surface = 'yes'
dum_spheres_number=1
dum_sphere_position_x= 11.338355932
dum_sphere_position_y=  0.
dum_sphere_position_z=  0.
dum_sphere_radius= 9.448629943
/

&EPS_FUNCTION
epsilon_omega='drude-lorentz'
eps_A=0.110224
eps_gm=0.001515
eps_w0=0.
f_vel=0.
/
&PROPAGATE  
propagation_type='charge-ief'
interaction_type='pcm'
interaction_stride=1
interaction_init='nsc'
/
&QUANTUM_COUPLING
/

