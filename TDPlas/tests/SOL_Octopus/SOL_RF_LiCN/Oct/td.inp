CalculationMode = td
UnitsOutput = eV_Angstrom

XYZCoordinates = 'LiCN.xyz'

TDPropagator = aetrs
TDTimeStep = 0.0023/eV
TDMaxSteps = 50

TDDeltaStrength = 0.01/angstrom
TDPolarizationDirection = 3

radius = 12.0*angstrom
spacing = 0.18*angstrom

PCMCalculation = yes
PCMStaticEpsilon = 35.688
PCMDynamicEpsilon = 1.0
PCMTDLevel = eom
PCMDebyeRelaxTime = 500.
PCMCavity = 'cavity_oct.inp'

FromScratch = yes
ExperimentalFeatures = yes
