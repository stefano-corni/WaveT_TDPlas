&PROPAGATE  
propagation_type='charge-ief'
interaction_type='pcm'
interaction_stride=1
interaction_init='nsc'
/

&MEDIUM
medium_type='sol'
medium_init0='frozen'
bem_type='diagonal'
bem_read_write='read'
/

&SURFACE
surface_type='mesh'
input_mesh='read_file'
/

&EPS_FUNCTION
epsilon_omega='debye'
eps_0=35.688
eps_d=1.       
tau_deb=500. 
/

&QUANTUM_COUPLING
/

&SYSTEM
test_type='non'
/

&OUT_MATRIX
/

