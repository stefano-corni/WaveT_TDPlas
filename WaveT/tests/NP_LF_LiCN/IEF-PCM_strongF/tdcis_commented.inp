&general 
n_ci=10              ! Number of excited states to use
n_ci_read=10         ! Number of excited states to read
mol_cc= 0. 0. 0.     ! Molecule centre of mass
medium='nan'         ! Nanoparticle as external medium
n_f=1                ! Number to append to output files
dt=0.01              ! Time step in atomic units
n_step=1000          ! Number of steps
n_out=1              ! Frequency of output printing
/ 

&field                                                                                                         
Ffld='pip'                 ! Pi pulse shape: cos^2(pi(t-t0)/(2s)) * cos(w(t-t0))                                                                             
omega=0.3239892104044628   ! Pulse frequency in atomic units
sigma=125.,                ! Amplitude (s) in atomic units
t_mid=125.                 ! Centre of pulse t0 in atomic units
radiative='non'            ! Radiative damping not applied
fmax= 0. 0.0 0.5           ! Pulse intensity along x y z in atomic units 
/                 
                 
&sse            
dissipative='non'          ! Dissipation is not included, coherent dynamics
/              
              
&spectra     
start=80             ! Initial time step considered for the spectra calculations
tau= 2000. 2000.     ! Damping of the molecule and the nanoparticle dipole moments
dir_ft= 1. 1. 1.     ! x y and z direction of the Fourier transform
/



