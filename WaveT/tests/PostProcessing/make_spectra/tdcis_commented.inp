&general 

n_ci=10              ! Number of excited states to use
n_ci_read=10         ! Number of excited states to read
mol_cc= 0. 0. 0.     ! Molecule centre of mass
medium='nan'         ! Nanoparticle as external medium
n_f=1                ! Number to append to output files
dt=0.1               ! Time step in atomic units
n_step=20000         ! Number of steps
n_out=1              ! Frequency of output printing
/

&field 
Ffld='lga'           ! Linearly modulated gaussian shaped pulse
sigma(1)=10,         ! Gaussian amplitude in atomic units
t_mid=100            ! Centre of gaussian pulse in atomic units
radiative='non'      ! Radiative damping not applied
npulse=1             ! Number of incident pulses
fmax(1,1) = 0.       ! Pulse intensity along x in atomic units
fmax(2,1) = 0.00001  ! Pulse intensity along y in atomic units
fmax(3,1) = 0.       ! Pulse intensity along z in atomic units
/

&sse
dissipative='non'    ! Dissipation is not included, coherent dynamics
/

&spectra 
start=0              ! Initial time step considered for the spectra calculations
tau= 2000. 2000.     ! Damping of the molecule and the nanoparticle dipole moments
dir_ft= 1. 1. 1.     ! x y and z direction of the Fourier transform
/

