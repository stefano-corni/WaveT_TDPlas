&SYSTEM
test_type='s-r'
/
&OUT_MATRIX
/
&MEDIUM
medium_type='nanop'
medium_init0='frozen'
bem_type='diagonal'
bem_read_write='read'
local_field='non'
/
&SURFACE
create_cavity = 'read_file'
input_surface='cavity'
!spheres_shape = 'spheres'
!spheres_number=1
!sphere_position_x= 0.
!sphere_position_y= 0.
!sphere_position_z= 0.
!sphere_radius= 10. 
/

&EPS_FUNCTION
epsilon_omega='drude-lorentz'
eps_A=0.110224
eps_gm=0.000757576
eps_w0=0.
f_vel=0.
/
&PROPAGATE  
propagation_type='charge-onsager'
interaction_type='onsager'
interaction_stride=1
interaction_init='nsc'
/


