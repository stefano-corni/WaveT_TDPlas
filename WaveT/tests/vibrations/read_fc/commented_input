&vibrations
nstates=2            ! number of electronic states
nvib=3               ! number of vibrational quanta on ES used
nvib_inp=3           ! number of vibrational quanta on ES read
nmodes=108           ! number of modes in the ES
nmodes_gs=108        ! number of modes in the GS
computefc=.false.    ! .false. to read fc.inp and ht.inp
diptype='fcht'       ! 'fc', 'ht', or 'fcht'
calctype='raman'     ! 'rayleigh' (compute  and read only GS(0)->ES(n)) terms or 'raman' (compute and read also GS(n)->ES(n)) calculations 
medium='vac'         ! 'nan' or 'vac', for nanoparticle (compute ci_pot_new) or in vacuum calculations
/

