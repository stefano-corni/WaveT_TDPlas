&general 
n_ci=10 
n_ci_read=10  
mol_cc= 0. 0. 0.
medium='nan'
n_f=1
dt=0.2
n_step=260
n_out=1
/ 

&field
Ffld='gau'
sigma(1)=1.0
t_mid=4.0
radiative='non'
npulse=1
fmax(1,1) = 0.00000
fmax(2,1) = 0.
fmax(3,1) = 0.
/

&sse
dissipative='non'
/

&spectra 
start=0 
tau= 10000 10000
dir_ft= 1. 0. 0. 
/

&freq
fmax= 1.  0.  0.
n_omega=500
omega_ini=0.01
omega_end=0.35
/

! Here starts the tdplas part
!
&PROPAGATE
propagation_type='ief'
interaction_type='pcm'
interaction_stride=1
interaction_init='SCF_ES'
test_type='non'
local_field='loc'
/

&MEDIUM
medium_type='nan'
medium_init='fro'
bem_type='stan'
bem_read_write='rea'
/

&SURFACE
input_surface='fil'
/


&EPS_FUNCTION
epsilon_omega='gen'
/

