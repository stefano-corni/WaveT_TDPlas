&general 
n_ci=10,
n_ci_read=10
mol_cc= 0.0 0.0 0.0
n_f=1,
medium='vac'
dt=0.005
n_step=100000 
n_out=1
binary='n'
/ 

&field Ffld='gau', 
       omega(1)=0.2420
       sigma(1)= 707.106781187  
       t_mid= 2500,
       radiative='non',
       iseed=123456789
       npulse=1
fmax(1,1)=0.01
fmax(2,1)=0.01
fmax(3,1)=0.01
/


&twodspectra
twodcalc='no'
/

&sse 
dissipative='mar',
idep=1,
dis_prop='Euler',
nrnd=0,
tdis=0,
nr_typ=1,
krnd=0.0
out_sse='y'
/

&spectra start=0, 

tau=
2.0
0.0

dir_ft=
0.0
1.0
0.0 
/

$pop_coh
/

