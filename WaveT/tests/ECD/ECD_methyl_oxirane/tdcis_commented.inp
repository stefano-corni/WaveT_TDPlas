&general 
n_ci=20,                        ! Number of excited states to use
n_ci_read=20                    ! Number of excited states to read
mol_cc=  0.0  0.0  0.0          ! Molecule centre of mass
n_f=1,                          ! Number to append to output files
medium='vac'                    ! Calculation performed in vacuum
dt=0.05                         ! Time step in atomic units
n_step=20670                    ! Number of steps
n_out=1                         ! Frequency of output printing
n_restart=1000000               ! Frequency of restart writing 
full='n'                        ! Relaxation included only from excited states towards ground state
propa='e'                       ! Energy term is propagated analytically
/

&field 
Ffld='gau',                     ! Gaussian shaped electric field
sigma(1)=1.650,                 ! Gaussian amplitude in atomic units 
t_mid=500.0,                    ! Centre of gaussian pulse in atomic units
radiative='non',                ! Radiative damping not applied
npulse=1,                       ! Number of pulses
Fmag='mag'                      ! Magnetic field is included
fmax(3,1)=0.00000169            ! Pulse intensity along z in atomic units
fmax(2,1)=0.00000000            ! Pulse intensity along y in atomic units
fmax(1,1)=0.00000000            ! Pulse intensity along x in atomic units
/

&sse 
dissipative='non',              ! Dissipation is not included, coherent dynamics
/

&spectra 
start=0,                        ! Initial time step considered for the spectra calculations
tau=200.0 0.0                   ! Damping of the molecule and the nanoparticle dipole moments
dir_ft= 0.0 0.0 1.0             ! x y and z direction of the Fourier transform
/
